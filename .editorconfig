# Shared editing defaults; formatters own language-specific layout.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,json5,toml,yaml,yml,md,markdown,html,css,js,ts,tsx,sh,bash,ps1}]
indent_size = 2

[*.{rs,py,pyi}]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# Preserve intentional Markdown hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
