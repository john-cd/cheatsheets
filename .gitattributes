# Normalize text files to LF and use language-aware diffs.
* text=auto eol=lf

# Source and structured text
*.md text diff=markdown
*.mdx text diff=markdown
*.json text diff=json
*.jsonc text diff=json
*.toml text diff=toml
*.lock text diff=toml
*.yaml text
*.yml text
*.xml text
*.sql text
*.csv text
*.sh text
*.bash text
*.ps1 text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.proto text
Dockerfile* text
.devcontainer.json linguist-language=JSON-with-Comments
devcontainer.json linguist-language=JSON-with-Comments
.vscode/*.json linguist-language=JSON-with-Comments

# Python
*.py text diff=python
*.pyi text diff=python
*.py3 text diff=python
*.pyw text diff=python
*.pyx text diff=python
*.pyz text diff=python
*.ipynb text
*.pyc binary
*.pyo binary
*.pyd binary

# Binary and generated assets
*.7z binary
*.avif binary
*.bz binary
*.bz2 binary
*.bzip2 binary
*.db binary
*.eps binary
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.lz binary
*.lzma binary
*.mov binary
*.mp3 binary
*.mp4 binary
*.onnx binary
*.otf binary
*.pdf binary
*.pdb binary
*.pkl binary
*.pickle binary
*.png binary
*.rar binary
*.tar binary
*.tgz binary
*.tif binary
*.tiff binary
*.ttf binary
*.wasm binary
*.webp binary
*.woff binary
*.woff2 binary
*.xz binary
*.zip binary
*.zst binary
*.patch -text

# Keep repository metadata out of source archives
.gitattributes export-ignore
.gitignore export-ignore
.gitkeep export-ignore
